{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "otus-msa alerts",
      "folder": "alerts",
      "interval": "1m",
      "rules": [
        {
          "uid": "otus-msa-latency-p95",
          "title": "API Latency P95 High",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 300,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "editorMode": "code",
                "expr": "histogram_quantile(\n  0.95,\n  sum by (le) (\n    rate(\n      http_request_duration_seconds_bucket{\n        handler!~\"/|/liveness|/metrics|/readiness|/docs|/openapi.json\",\n        status=~\"2.*\"\n      }[5m]\n    )\n  )\n) * 1000\n",
                "hide": false,
                "instant": false,
                "intervalMs": 1000,
                "legendFormat": "P95",
                "maxDataPoints": 43200,
                "range": true,
                "refId": "A"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": []
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "name": "Expression",
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "A",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "reducer": "last",
                "refId": "B",
                "type": "reduce"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "conditions": [
                  {
                    "evaluator": {
                      "params": [
                        300
                      ],
                      "type": "gt"
                    },
                    "operator": {
                      "type": "and"
                    },
                    "query": {
                      "params": []
                    },
                    "reducer": {
                      "params": [],
                      "type": "last"
                    },
                    "type": "query"
                  }
                ],
                "datasource": {
                  "name": "Expression",
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "expression": "B",
                "intervalMs": 1000,
                "maxDataPoints": 43200,
                "refId": "C",
                "type": "threshold"
              }
            }
          ],
          "noDataState": "NoData",
          "execErrState": "Error",
          "for": "2m",
          "keepFiringFor": "2m",
          "annotations": {
            "summary": "API P95 latency is high",
            "description": "API P95 latency is {{ $values.B }} ms for the last 5 minutes."
          },
          "labels": {
            "severity": "warning"
          },
          "notification_settings": {
            "receiver": "events"
          }
