{
  "info": {
    "name": "hw4-user-api",
    "description": "Postman collection for hw4 User CRUD API. Run via newman:\n    newman run hw4-app.postman_collection.json\n\nMake sure arch.homework resolves to your cluster IP (e.g. minikube ip or /etc/hosts).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health checks",
      "item": [
        {
          "name": "Liveness",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/liveness",
              "host": ["{{baseUrl}}"],
              "path": ["liveness"]
            }
          }
        },
        {
          "name": "Readiness",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/readiness",
              "host": ["{{baseUrl}}"],
              "path": ["readiness"]
            }
          }
        }
      ]
    },
    {
      "name": "Users CRUD",
      "item": [
        {
          "name": "Create user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response has id\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('name', pm.iterationData.get('userName') || 'Alice');",
                  "    pm.expect(json).to.have.property('email', pm.iterationData.get('userEmail') || 'alice@example.com');",
                  "    pm.expect(json).to.have.property('age', pm.iterationData.get('userAge') || 30);",
                  "    pm.collectionVariables.set('userId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Alice\",\n    \"email\": \"alice@example.com\",\n    \"age\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/",
              "host": ["{{baseUrl}}"],
              "path": ["users", ""]
            }
          }
        },
        {
          "name": "Create user – Bob (second user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response has id\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('name', 'Bob');",
                  "    pm.collectionVariables.set('userId2', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Bob\",\n    \"email\": \"bob@example.com\",\n    \"age\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/",
              "host": ["{{baseUrl}}"],
              "path": ["users", ""]
            }
          }
        },
        {
          "name": "List users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is an array with at least 2 users\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    pm.expect(json.length).to.be.at.least(2);",
                  "    pm.expect(json[0]).to.have.property('id');",
                  "    pm.expect(json[0]).to.have.property('name');",
                  "    pm.expect(json[0]).to.have.property('email');",
                  "    pm.expect(json[0]).to.have.property('age');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/",
              "host": ["{{baseUrl}}"],
              "path": ["users", ""]
            }
          }
        },
        {
          "name": "Get user by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const userId = pm.collectionVariables.get('userId');",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response matches created user\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(userId);",
                  "    pm.expect(json.name).to.eql('Alice');",
                  "    pm.expect(json.email).to.eql('alice@example.com');",
                  "    pm.expect(json.age).to.eql(30);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Update user (rename + change age)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const userId = pm.collectionVariables.get('userId');",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response has updated fields\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(userId);",
                  "    pm.expect(json.name).to.eql('Alice Updated');",
                  "    pm.expect(json.email).to.eql('alice@example.com');",
                  "    pm.expect(json.age).to.eql(31);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Alice Updated\",\n    \"age\": 31\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Delete user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Get deleted user (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Response has detail\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('detail', 'User not found');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          }
        },
        {
          "name": "Delete user Bob (cleanup)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId2}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId2}}"]
            }
          }
        },
        {
          "name": "Get deleted Bob (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId2}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId2}}"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "arch.homework",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId2",
      "value": "",
      "type": "string"
    }
  ]
}
