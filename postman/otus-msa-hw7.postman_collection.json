{
  "info": {
    "_postman_id": "8f6b5a4c-1234-5678-9abc-def012345678",
    "name": "OTUS MSA HW7 — Billing / Order / Notification",
    "description": "Сценарий: создать пользователя → создать счёт → положить деньги → заказ → проверить баланс и уведомления.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "arch.homework",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "initialBalance",
      "value": "1000",
      "type": "string"
    },
    {
      "key": "orderPriceOk",
      "value": "500",
      "type": "string"
    },
    {
      "key": "orderPriceFail",
      "value": "9999",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{$randomUserName}}\",\n  \"email\": \"admin@cianoid.ru\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/auth/register",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.access_token);",
                  "pm.collectionVariables.set('username', JSON.parse(pm.request.body.raw).username);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Billing",
      "item": [
        {
          "name": "Deposit money",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{initialBalance}}\n}"
            },
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/billing/deposit",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "billing", "deposit"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(Number(json.balance)).to.eql(Number(pm.collectionVariables.get('initialBalance')));",
                  "pm.collectionVariables.set('balance', json.balance);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get account balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/billing/account",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "billing", "account"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.username).to.eql(pm.collectionVariables.get('username'));",
                  "pm.collectionVariables.set('balance', json.balance);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Order — enough money",
      "item": [
        {
          "name": "Create order (success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": {{orderPriceOk}}\n}"
            },
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/order",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "order"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.expect(json.status).to.eql('paid');",
                  "pm.collectionVariables.set('orderIdOk', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get balance after order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/billing/account",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "billing", "account"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "const expected = Number(pm.collectionVariables.get('initialBalance')) - Number(pm.collectionVariables.get('orderPriceOk'));",
                  "pm.expect(Number(json.balance)).to.eql(expected);",
                  "pm.collectionVariables.set('balanceAfterOk', json.balance);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Check notification (success)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/notification",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notification"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const expectedType = 'ORDER_SUCCESS';",
                  "const attempt = Number(pm.collectionVariables.get('notificationAttemptSuccess') || 0);",
                  "const notifications = pm.response.json();",
                  "const found = notifications.find(n => n.message_type === expectedType && n.status === 'SENT');",
                  "console.log('notifications:', JSON.stringify(notifications, null, 2));",
                  "if (found || attempt >= 10) {",
                  "  pm.collectionVariables.unset('notificationAttemptSuccess');",
                  "  pm.expect(notifications.length).to.be.greaterThan(0);",
                  "  pm.expect(found, expectedType + ' notification should exist').to.not.be.undefined;",
                  "} else {",
                  "  pm.collectionVariables.set('notificationAttemptSuccess', attempt + 1);",
                  "  setTimeout(() => postman.setNextRequest(pm.info.requestName), 1000);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Order — not enough money",
      "item": [
        {
          "name": "Create order (failed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
