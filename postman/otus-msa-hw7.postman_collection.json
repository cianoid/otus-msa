              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": {{orderPriceFail}}\n}"
            },
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/order",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "order"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.expect(json.status).to.eql('failed');",
                  "pm.collectionVariables.set('orderIdFail', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get balance after failed order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/billing/account",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "billing", "account"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(Number(json.balance)).to.eql(Number(pm.collectionVariables.get('balanceAfterOk')));",
                  "pm.collectionVariables.set('balanceAfterFail', json.balance);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Check notification (failed)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/notification",
              "protocol": "http",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notification"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const expectedType = 'ORDER_FAILED';",
                  "const attempt = Number(pm.collectionVariables.get('notificationAttemptFailed') || 0);",
                  "const notifications = pm.response.json();",
                  "const found = notifications.find(n => n.message_type === expectedType && n.status === 'SENT');",
                  "console.log('notifications:', JSON.stringify(notifications, null, 2));",
                  "if (found || attempt >= 10) {",
                  "  pm.collectionVariables.unset('notificationAttemptFailed');",
                  "  pm.expect(notifications.length).to.be.greaterThan(0);",
                  "  pm.expect(found, expectedType + ' notification should exist').to.not.be.undefined;",
                  "} else {",
                  "  pm.collectionVariables.set('notificationAttemptFailed', attempt + 1);",
                  "  setTimeout(() => postman.setNextRequest(pm.info.requestName), 1000);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
