                  "}",
                  "console.log('RESPONSE:', pm.response.code, pm.response.text());",
                  "const attempt = Number(pm.collectionVariables.get('depositAttempt') || 0);",
                  "if (pm.response.code === 404 && attempt < 10) {",
                  "  pm.collectionVariables.set('depositAttempt', attempt + 1);",
                  "  console.log('Billing account not ready yet, retrying deposit (attempt ' + (attempt + 1) + '/10)...');",
                  "  setTimeout(() => postman.setNextRequest(pm.info.requestName), 1000);",
                  "} else {",
                  "  pm.collectionVariables.unset('depositAttempt');",
                  "  pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "  const json = pm.response.json();",
                  "  pm.test('Billing account created, balance equals deposit', () => {",
                  "    pm.expect(Number(json.balance)).to.eql(Number(pm.collectionVariables.get('initialBalance')));",
