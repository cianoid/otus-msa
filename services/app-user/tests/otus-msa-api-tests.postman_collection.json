{
  "info": {
    "name": "OTUS MSA User API Tests",
    "description": "Коллекция тестов для OTUS MSA User Management API.\n\nСценарий:\n  1. Регистрация пользователя 1\n  2. Проверка, что изменение и получение профиля недоступно без логина\n  3. Вход пользователя 1\n  4. Изменение профиля пользователя 1\n  5. Проверка, что профиль поменялся\n  6. Выход — эндпоинт отсутствует в API (пропущен)\n  7. Регистрация пользователя 2\n  8. Вход пользователя 2\n  9. Проверка, что пользователь 2 не имеет доступа на чтение и редактирование профиля пользователя 1\n\nЗапуск через newman:\n  newman run otus-msa-api-tests.postman_collection.json --verbose",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://arch.homework",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. User 1 — Registration & Auth",
      "description": "Регистрация первого пользователя со случайными данными и проверка недоступности профиля без аутентификации.",
      "item": [
        {
          "name": "1.1 Register User 1",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// ── Генерация случайных данных для User 1 ──",
                  "const suffix = Math.random().toString(36).substring(2, 8);",
                  "pm.collectionVariables.set('user1_username', 'user1_' + suffix);",
                  "pm.collectionVariables.set('user1_password', 'Pass' + suffix + '!1');",
                  "pm.collectionVariables.set('user1_email', 'user1_' + suffix + '@example.com');",
                  "pm.collectionVariables.set('user1_age', String(Math.floor(Math.random() * 40) + 18));",
                  "pm.collectionVariables.set('user1_real_name', 'User One ' + suffix);",
                  "",
                  "console.log('>>> [REGISTER USER1] Данные запроса:');",
                  "console.log('  username :', pm.collectionVariables.get('user1_username'));",
                  "console.log('  email    :', pm.collectionVariables.get('user1_email'));",
                  "console.log('  password :', pm.collectionVariables.get('user1_password'));",
                  "console.log('  age      :', pm.collectionVariables.get('user1_age'));",
                  "console.log('  real_name:', pm.collectionVariables.get('user1_real_name'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "console.log('<<< [REGISTER USER1] Ответ:');",
                  "console.log('  Status:', pm.response.code);",
                  "try { console.log('  Body  :', JSON.stringify(pm.response.json(), null, 2)); } catch(e) { console.log('  Body  :', pm.response.text()); }",
                  "",
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has access_token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('access_token');",
                  "    pm.expect(json.access_token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('user1_token', json.access_token);",
                  "});",
                  "",
                  "pm.test('Response has refresh_token', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('refresh_token');",
                  "    pm.collectionVariables.set('user1_refresh_token', json.refresh_token);",
                  "});",
                  "",
                  "pm.test('token_type is bearer', function () {",
                  "    pm.expect(pm.response.json().token_type).to.eql('bearer');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{user1_username}}\",\"email\":\"{{user1_email}}\",\"password\":\"{{user1_password}}\",\"age\":{{user1_age}},\"real_name\":\"{{user1_real_name}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
